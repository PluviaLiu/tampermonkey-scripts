// ==UserScript==
// @name         Copy_Latex_sourcecode
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  选中文本后按 Alt+C，自动将选中区域内的 MathJax/KaTeX 公式转换为标准 LaTeX 格式并复制
// @author       YourName
// @match        *://*/*
// @grant        GM_setClipboard
// ==/UserScript==

(function() {
    'use strict';

    // 监听键盘事件
    window.addEventListener('keydown', function(e) {
        // 快捷键：Alt + C (你可以自己修改，比如 e.ctrlKey && e.key === 'c')
        if (e.altKey && e.key.toLowerCase() === 'c') {
            const selection = window.getSelection();
            if (!selection || selection.rangeCount === 0) return;

            // 获取选中区域的 DOM 片段
            const container = document.createElement('div');
            for (let i = 0; i < selection.rangeCount; i++) {
                container.appendChild(selection.getRangeAt(i).cloneContents());
            }

            // 处理 MathJax (常见的行内和块级公式标记)
            // MathJax 通常把源码放在 <script type="math/tex"> 或 math elements 的 data-expr / data-latex 属性里
            const mathJaxScripts = container.querySelectorAll('script[type^="math/tex"]');
            mathJaxScripts.forEach(script => {
                const isBlock = script.type.includes('mode=display');
                const delimiter = isBlock ? '$$\n' : '$';
                script.outerHTML = `${delimiter}${script.textContent.trim()}${delimiter}`;
            });

            // 处理 KaTeX 和新版 MathJax 3 (通常包含 <annotation encoding="application/x-tex">)
            const annotations = container.querySelectorAll('annotation[encoding="application/x-tex"]');
            annotations.forEach(anno => {
                // 寻找它的外层包裹，判断是行内还是块级
                const isBlock = anno.closest('.katex-display, .MathJax_Display') !== null;
                const delimiter = isBlock ? '$$\n' : '$';

                // 替换掉整个数学符号的父级容器
                const mathRoot = anno.closest('.katex, .MathJax') || anno.parentElement;
                if (mathRoot) {
                    mathRoot.outerHTML = `${delimiter}${anno.textContent.trim()}${delimiter}`;
                }
            });

            // 获取清洗后的文本
            let finalMarkdown = container.innerText;

            // 稍微清理一下连续的空行
            finalMarkdown = finalMarkdown.replace(/\n{3,}/g, '\n\n');

            // 复制到剪贴板
            if (finalMarkdown.trim()) {
                GM_setClipboard(finalMarkdown);
                showToast('LaTeX 文本已复制！');
            }
        }
    });

    // 简单的提示框反馈
    function showToast(message) {
        const toast = document.createElement('div');
        toast.textContent = message;
        toast.style.position = 'fixed';
        toast.style.bottom = '20px';
        toast.style.right = '20px';
        toast.style.background = '#333';
        toast.style.color = '#fff';
        toast.style.padding = '10px 20px';
        toast.style.borderRadius = '5px';
        toast.style.zIndex = '10000';
        toast.style.fontFamily = 'sans-serif';
        toast.style.fontSize = '14px';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 2000);
    }
})();
