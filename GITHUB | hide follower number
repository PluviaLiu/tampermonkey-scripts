// ==UserScript==
// @name         GitHub Anti-Anxiety Filter (Followers Only)
// @namespace    http://tampermonkey.net/
// @version      1.1
// @description  精准抹除 GitHub 上的粉丝数（Followers），保留正在关注（Following）功能
// @author       Your AI Collaborator
// @match        https://github.com/*
// @icon         https://www.google.com/s2/favicons?sz=64&domain=github.com
// @grant        GM_addStyle
// @run-at       document-start
// ==/UserScript==

(function() {
    'use strict';

    const css = `
        /* 1. 精准隐藏个人主页左侧侧边栏的 followers 链接与数字 */
        a[href*="tab=followers"] {
            display: none !important;
        }

        /* 2. 隐藏 followers 前面的那颗“小人”图标以及后面的逗号分隔符 */
        a[href*="tab=followers"] + span,
        .vcard-details span.color-fg-muted:has(+ a[href*="tab=following"]) {
            /* 适配部分旧版前端的特殊文本节点处理 */
        }

        /* 3. 隐藏右上角个人头像下拉菜单里的 "Your followers" 选项 */
        a.dropdown-item[href*="tab=followers"] {
            display: none !important;
        }

        /* 4. 彻底干掉主页左侧排版可能残留的文字细节，微调 Following 的显示 */
        .vcard-details .mb-3 {
            /* 确保隐藏后，剩下的 "following" 依然能正常对齐 */
        }
    `;

    if (typeof GM_addStyle !== "undefined") {
        GM_addStyle(css);
    } else {
        const style = document.createElement("style");
        style.insertBefore(document.createTextNode(css), style.childNodes[0]);
        const head = document.head || document.getElementsByTagName("head")[0];
        if (head) {
            head.appendChild(style);
        }
    }
})();
